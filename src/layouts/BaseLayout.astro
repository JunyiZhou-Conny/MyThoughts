---
import "../styles/global.css";

interface Props {
  title: string;
  description?: string;
  current?: "home" | "thoughts" | "about" | "inbox";
}

const {
  title,
  description = "A public studio for thoughts written by hand.",
  current,
} = Astro.props;

const pageTitle = title === "My Thoughts" ? title : `${title} — My Thoughts`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <title>{pageTitle}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans:ital,wght@0,400;0,500;1,400&family=Source+Serif+4:ital,opsz,wght@0,8..60,400;0,8..60,500;0,8..60,550;1,8..60,400&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <header class="site-header">
      <div class="shell site-header__inner">
        <a class="wordmark" href="/">My Thoughts</a>
        <nav class="nav" aria-label="Primary">
          <a href="/thoughts" aria-current={current === "thoughts" ? "page" : undefined}>Thoughts</a>
          <a href="/about" aria-current={current === "about" ? "page" : undefined}>About</a>
          {
            import.meta.env.DEV && (
              <a href="/inbox" aria-current={current === "inbox" ? "page" : undefined}>
                Inbox
              </a>
            )
          }
        </nav>
      </div>
    </header>
    <main id="main" class="site-main">
      <div class="shell">
        <slot />
      </div>
    </main>
    <footer class="site-footer">
      <div class="shell site-footer__inner">
        <p>Written by hand.</p>
        <p>© {new Date().getFullYear()} Junyi Zhou</p>
      </div>
    </footer>
  </body>
</html>
